 #include "libregexp.h"
 #include "dtoa.h"
 
+#ifdef GOC_QJS_GSTACK
+#include "../../runtime/goc_uptr.h"
+#endif
+
 #if defined(EMSCRIPTEN) || defined(_MSC_VER)
 #define DIRECT_DISPATCH  0
 #else
@@ -2305,8 +2309,18 @@ static inline uintptr_t js_get_stack_pointer(void)
 static inline bool js_check_stack_overflow(JSRuntime *rt, size_t alloca_size)
 {
     uintptr_t sp;
+#ifdef GOC_QJS_GSTACK
+    /* Go may copy this frame to a new stack address at any nested call.
+       Measure the logical depth from the *current* g.stack.hi, not the
+       absolute stack_top captured when the runtime was created. */
+    uintptr_t hi = goc_stack_hi();
+    sp = js_get_stack_pointer() - alloca_size;
+    return unlikely(rt->stack_size != 0 &&
+                    (sp > hi || hi - sp > rt->stack_size));
+#else
     sp = js_get_stack_pointer() - alloca_size;
     return unlikely(sp < rt->stack_limit);
+#endif
 }
 
