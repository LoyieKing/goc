#!/usr/bin/env bash
# goc — experimental C-on-Go-stacks driver (P28 surface)
set -euo pipefail
SELF="$(cd "$(dirname "$0")" && pwd)"
# Resolve repo root: cmd/ -> repo, or GOC_ROOT override
if [[ -n "${GOC_ROOT:-}" ]]; then
  ROOT="$(cd "$GOC_ROOT" && pwd)"
else
  ROOT="$(cd "$SELF/.." && pwd)"
fi
export GOC_ROOT="$ROOT"
# shellcheck source=scripts/goc-flags.sh
source "$ROOT/scripts/goc-flags.sh"

usage() {
  cat <<'USAGE'
goc — experimental compiler driver (pointer-colored C → Go stacks)

Usage:
  goc go [dir] [-o bin] [flags] [-- …]
      Compile a Go package's .c files and link. Ignores inherited GOC_* .
  goc check [flags]
      Toolchain self-check: build and run examples/hello
  goc toolchain status|pack DEST [flags]
      Resolve or pack the relocatable toolchain
  goc build foo.c -o foo.o [flags] [-- …]
      In-tree Clang Sema → real-body goobj (P28). Default -O0.
  goc cc [--clang PATH] [clang-args…]
      Invoke resolved clang with goc include/attrs
  goc test [--clang PATH] [--p27|--p28]
      Run curated golden tests
  goc version
  goc help | -h | --help

`goc go` / `goc check` defaults:
  -O3 --default-ptr-color cptr --fast-stack-alloca
  --fast-stack-alloca is much faster and single-threaded only: the alloca
  pool cursor is process-global, so concurrent calls are not thread-safe.
  Morestack, splittable frames, and sptr maps are always on.
  linux/amd64. --fixed-g and --opt-extra=-inline-threshold=250 stay off.
`goc build --goabi` turns on morestack and splittable frames as well. amd64
also records sptr maps. arm64 cannot. `goc build` without `--goabi` stays at
-O0. A flag wins over an inherited variable.

From-zero instructions: docs/quickstart.md
USAGE
  echo
  goc_flags_help
}

cmd_version() {
  echo "goc experimental P28 (2026-09-22) — C-on-Go-stacks research compiler"
}

resolve_clang() {
  local clang=""
  local intree_candidates=(
    "$ROOT/third_party/llvm-19.1.7-clang-build/bin/clang"
    "$ROOT/third_party/llvm-clang-build/bin/clang"
  )
  if [[ -n "${GOC_CLANG:-}" ]]; then
    clang="$GOC_CLANG"
  else
    local c
    for c in "${intree_candidates[@]}"; do
      if [[ -x "$c" ]]; then clang="$c"; break; fi
    done
    if [[ -z "$clang" ]]; then
      clang="${CLANG_FALLBACK:-clang-19}"
    fi
  fi
  echo "$clang"
}

is_intree_clang() {
  local clang="$1"
  # Heuristic: user-built tree under third_party, or GOC_CLANG explicitly set
  # with GOC_USE_INTREE preference. Prefer intree attrs when GOC_CLANG is set
  # or path contains llvm-*-clang-build.
  if [[ -n "${GOC_CLANG:-}" ]]; then return 0; fi
  case "$clang" in
    *llvm*clang-build*) return 0 ;;
    *third_party*) return 0 ;;
  esac
  return 1
}

# In-tree and packed clangs need their own libLLVM. Prepend that lib dir so
# goc-llc and goc-color-escape start without a hand-set LD_LIBRARY_PATH.
prepend_clang_lib() {
  local clang="$1" bin libdir
  bin="$(readlink -f "$clang" 2>/dev/null || true)"
  [[ -n "$bin" ]] || return 0
  libdir="$(cd "$(dirname "$bin")/../lib" 2>/dev/null && pwd || true)"
  [[ -n "$libdir" && -e "$libdir/libLLVM.so.19.1" ]] || return 0
  case ":${LD_LIBRARY_PATH:-}:" in
    *":$libdir:"*) ;;
    *) export LD_LIBRARY_PATH="$libdir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
  esac
}

cmd_cc() {
  local CLANG PLUGIN INC
  GOC_FLAG_MODE=driver
  while [[ $# -gt 0 ]]; do
    if goc_consume_flag "$1" "${2:-}"; then
      shift "$GOC_FLAG_SHIFT"
      continue
    fi
    break
  done
  unset GOC_FLAG_MODE
  CLANG="$(resolve_clang)"
  prepend_clang_lib "$CLANG"
  INC="$ROOT/include"
  PLUGIN="$ROOT/clang/plugin/../build/libGocClang.so"
  # Prefer plugin build dir next to plugin sources
  if [[ ! -f "$PLUGIN" ]]; then
    PLUGIN="$ROOT/build/libGocClang.so"
  fi
  if [[ ! -f "$PLUGIN" ]]; then
    PLUGIN="$ROOT/clang/build/libGocClang.so"
  fi

  if is_intree_clang "$CLANG"; then
    exec "$CLANG" -DGOC_USE_INTREE_ATTRS -I "$INC" "$@"
  fi
  # LEGACY plugin path
  if [[ ! -f "$PLUGIN" ]]; then
    make -C "$ROOT/clang/plugin" all OBJDIR="$ROOT/build" TARGET="$ROOT/build/libGocClang.so" || \
      make -C "$ROOT/clang/plugin" all
    PLUGIN="$ROOT/build/libGocClang.so"
    [[ -f "$PLUGIN" ]] || PLUGIN="$ROOT/clang/plugin/../build/libGocClang.so"
  fi
  if [[ -f "$PLUGIN" ]]; then
    exec "$CLANG" -fplugin="$PLUGIN" -DGOC_USE_PLUGIN_ATTRS -I "$INC" "$@"
  fi
  echo "goc cc: warning: no in-tree clang and no plugin; using annotate-only attrs" >&2
  exec "$CLANG" -I "$INC" "$@"
}

cmd_build() {
  if [[ $# -eq 0 ]]; then
    exec bash "$ROOT/scripts/test-p28.sh"
  fi
  local SRC="" OUT_O="" EXTRA=() ALL=0 GOABI=0 ABI0=0
  while [[ $# -gt 0 ]]; do
    if goc_consume_flag "$1" "${2:-}"; then
      shift "$GOC_FLAG_SHIFT"
      continue
    fi
    case "$1" in
      -o) OUT_O="$2"; shift 2 ;;
      --all) ALL=1; shift ;;
      --goabi) GOABI=1; ALL=1; shift ;;
      --abi0) ABI0=1; ALL=1; shift ;;
      --) shift; EXTRA+=("$@"); break ;;
      -h|--help)
        echo "usage: goc build [foo.c -o foo.o] [flags] [-- clang-args]"
        echo "       goc build            # P28 test suite"
        echo "  --all: emit TEXT for every defined function (P29 multi-function)"
        echo "  --goabi: Go ABIInternal entry thunks (amd64 SysV, or arm64 AAPCS64)"
        echo "  --abi0:  emit ABI0 TEXT (C-side SysV entry points, e.g. libc shim)"
        echo
        goc_flags_help
        exit 0
        ;;
      -*) EXTRA+=("$1"); shift ;;
      *)
        if [[ -z "$SRC" ]]; then SRC="$1"; shift
        else EXTRA+=("$1"); shift
        fi
        ;;
    esac
  done
  if [[ -z "$SRC" ]]; then
    if [[ -n "${GOC_FLAG_SEEN// /}" ]]; then
      echo "goc build: missing input file" >&2
      exit 2
    fi
    exec bash "$ROOT/scripts/test-p28.sh"
  fi
  if [[ -z "$OUT_O" ]]; then
    OUT_O="${SRC%.c}.o"
    OUT_O="${OUT_O%.goc}.o"
  fi

  # Default stays linux/amd64. arm64 is a separate backend, not -march.
  GOC_ARCH="${GOC_ARCH:-amd64}"
  case "$GOC_ARCH" in
    amd64|arm64) ;;
    *) echo "goc build: FATAL GOC_ARCH=$GOC_ARCH (want amd64 or arm64)" >&2; exit 1 ;;
  esac
  export GOC_ARCH
  if [[ "$GOC_ARCH" == arm64 ]]; then
    # gep is unsafe across a stack copy until GocFrameAddrFix exists for
    # AArch64, and the x86 leaq remat does not assemble. Force the stock
    # llc path and refuse the x86 stack-map repairs.
    export GOC_FRAMEADDR_MODE=asm
    if [[ "${GOC_SPTR_MAPS:-0}" == 1 || "${GOC_CSR_ADJUST:-0}" == 1 ]]; then
      echo "goc build: FATAL GOC_SPTR_MAPS and GOC_CSR_ADJUST are x86-only; arm64 has no frame-address repair" >&2
      exit 1
    fi
    case "$SRC" in
      *runtime/uptr/*) ;;
      *)
        if grep -E -q 'movq[[:space:]]+%%fs:-8|"syscall"' "$SRC"; then
          echo "goc build: FATAL $SRC is a linux/amd64 host (movq %%fs:-8 or syscall) and is not ported to arm64" >&2
          exit 1
        fi
        ;;
    esac
  fi

  # Go linking needs a splittable frame and a morestack prologue. amd64 also
  # records sptr maps. arm64 has no frame-address repair, so maps stay off.
  if [[ $GOABI -eq 1 ]]; then
    export GOC_MORESTACK=1
    export GOC_NO_NOSPLIT=1
    if [[ "$GOC_ARCH" == amd64 ]]; then
      export GOC_SPTR_MAPS=1
    fi
  fi

  local CLANG USE_PLUGIN=0
  CLANG="$(resolve_clang)"
  prepend_clang_lib "$CLANG"
  if ! is_intree_clang "$CLANG"; then
    USE_PLUGIN=1
  fi
  local INC="$ROOT/include"
  local COLOR_ESC="${GOC_COLOR_ESCAPE:-$ROOT/frontend/color-escape/build/goc-color-escape}"
  # amd64 gep remat is only safe with goc-llc's GocFrameAddrFix. Passing
  # stock llc-19 here used to skip realbody's missing-binary check, so tail
  # duplication kept frame addresses in callee-saved registers across calls.
  local LLC="${LLC:-}"
  if [[ "$GOC_ARCH" == arm64 ]]; then
    # goc-llc is the X86-only in-tree backend. arm64 ISel is system llc-19.
    case "$LLC" in
      *goc-llc*|"") LLC=llc-19 ;;
    esac
  elif [[ -z "$LLC" && "${GOC_FRAMEADDR_MODE:-gep}" != "asm" ]]; then
    LLC="$ROOT/backend/build/pass-out/goc-llc"
  elif [[ -z "$LLC" ]]; then
    LLC=llc-19
  fi
  local REALBODY="$ROOT/backend/realbody/goc_p28_realbody.sh"
  local PLUGIN="$ROOT/build/libGocClang.so"
  local OPT_LEVEL="${GOC_OPT_LEVEL:-0}"
  case "$OPT_LEVEL" in
    0|1|2|3) ;;
    *) echo "goc build: GOC_OPT_LEVEL must be 0, 1, 2, or 3" >&2; exit 1 ;;
  esac

  if [[ ! -x "$COLOR_ESC" ]]; then
    if [[ -n "${GOC_COLOR_ESCAPE:-}" ]]; then
      echo "goc build: missing color-escape pass $COLOR_ESC" >&2
      exit 1
    fi
    make -C "$ROOT/frontend/color-escape/pass" all
    [[ -x "$COLOR_ESC" ]] || { echo "goc build: missing color-escape pass" >&2; exit 1; }
  fi

  local TMP
  TMP="$(mktemp -d)"
  cleanup_build_tmp() {
    if [[ -n "${GOC_KEEP_TMP:-}" ]]; then
      echo "goc build: kept $TMP" >&2
      return 0
    fi
    rm -rf "$TMP"
  }

  # Go-stack compatible codegen: no red zone, no stack protector, no unwind tables.
  local CLANG_ARGS=(-mno-red-zone -fno-stack-protector -fno-asynchronous-unwind-tables
                    -I "$INC" -emit-llvm -S "-O$OPT_LEVEL")
  if [[ "${GOC_COLOR_REPORT:-}" == 1 ]]; then
    # Names and declaration lines for bare T* live in debug info. Coloring
    # ignores dbg records; the report is printed from the same pass tables.
    CLANG_ARGS+=(-g)
  fi
  if [[ "$OPT_LEVEL" == 0 ]]; then
    CLANG_ARGS+=(-Xclang -disable-O0-optnone)
  else
    # Color/escape analysis must see the original pointer stores before SROA
    # and inlining. -disable-llvm-passes keeps this IR uninlined without
    # stamping noinline: that attribute would survive into opt and block the
    # inliner. Source __attribute__((noinline)) is preserved. O3 runs below,
    # and stack maps run after it so an inlined callee is part of the caller.
    CLANG_ARGS+=(-fwrapv -fno-strict-aliasing
                 -fno-omit-frame-pointer -mno-omit-leaf-frame-pointer
                 -fno-optimize-sibling-calls -Xclang -disable-llvm-passes)
  fi
  if [[ $USE_PLUGIN -eq 0 ]]; then
    CLANG_ARGS=(-DGOC_USE_INTREE_ATTRS "${CLANG_ARGS[@]}")
    echo "goc build: in-tree/clang=$CLANG (no -fplugin)" >&2
  else
    if [[ ! -f "$PLUGIN" ]]; then
      make -C "$ROOT/clang/plugin" all OBJDIR="$ROOT/build" 2>/dev/null || \
        make -C "$ROOT/clang/plugin" all || true
      PLUGIN="$ROOT/build/libGocClang.so"
    fi
    if [[ -f "$PLUGIN" ]]; then
      CLANG_ARGS=(-fplugin="$PLUGIN" -DGOC_USE_PLUGIN_ATTRS "${CLANG_ARGS[@]}")
      echo "goc build: LEGACY plugin path clang=$CLANG" >&2
    else
      echo "goc build: annotate-only path clang=$CLANG (no plugin built)" >&2
    fi
  fi

  if [[ "$GOC_ARCH" == arm64 ]]; then
    # IR datalayout must be aarch64. -ffixed-x28 matches llc's reservation
    # of g; the in-tree clang accepts it and records +reserve-x28.
    CLANG_ARGS+=(-target aarch64-unknown-linux-gnu -ffixed-x28)
  fi
  if ! "$CLANG" "${CLANG_ARGS[@]}" "${EXTRA[@]}" -o "$TMP/a.ll" "$SRC"; then
    echo "goc build: Clang Sema/frontend failed for $SRC" >&2
    cleanup_build_tmp
    exit 1
  fi

  local COLOR_ESC_ARGS=(-fatal-errors=true)
  if [[ -n "${GOC_DEFAULT_PTR_COLOR:-}" ]]; then
    COLOR_ESC_ARGS+=("-default-ptr-color=$GOC_DEFAULT_PTR_COLOR")
  fi
  if ! "$COLOR_ESC" "$TMP/a.ll" -o "$TMP/a.color.ll" "${COLOR_ESC_ARGS[@]}"; then
    echo "goc build: pointer-color/escape analysis failed for $SRC" >&2
    cleanup_build_tmp
    exit 1
  fi
  local BODY_LL="$TMP/a.color.ll"
  if [[ "${GOC_COLOR_REPORT:-}" == 1 ]]; then
    # The report already ran inside the pass. -g leaves !dbg on the define
    # line, and realbody appends "no-realign-stack" after that attachment,
    # which llc rejects. Drop debug only. Keep names and !goc.color.
    local STRIP="${OPT:-opt-19}"
    if ! "$STRIP" --strip-debug -S "$BODY_LL" -o "$TMP/a.color.nodbg.ll"; then
      echo "goc build: failed to strip debug info after color report for $SRC" >&2
      cleanup_build_tmp
      exit 1
    fi
    BODY_LL="$TMP/a.color.nodbg.ll"
  fi
  local STACKMAP_PREPARED=0
  if [[ "$OPT_LEVEL" != 0 ]]; then
    local OPT="${OPT:-opt-19}"
    local SMPASS="${GOC_STACKMAP:-$ROOT/backend/build/pass-out/GocStackMap.so}"
    [[ -f "$SMPASS" ]] || { echo "goc build: missing $SMPASS" >&2; cleanup_build_tmp; exit 1; }
    # goc-inline-gate is a no-op: call-bearing functions may inline. Maps are
    # recorded after O3 on the merged frame. Stack-pointer arguments and slots
    # that keep &s->token are reanchored so copystack adjusts them.
    if ! "$OPT" -load-pass-plugin="$SMPASS" -passes=goc-inline-gate \
        -S "$BODY_LL" -o "$TMP/a.gate.ll"; then
      cleanup_build_tmp
      exit 1
    fi
    BODY_LL="$TMP/a.gate.ll"
    local PIPELINE
    PIPELINE="$("$OPT" "-passes=default<O$OPT_LEVEL>" -print-pipeline-passes -disable-output /dev/null)"
    # Stack maps, recorded after this pipeline, model SysV outgoing areas.
    # argpromotion and globalopt rewrite internal calls (fastcc, fewer args)
    # and would make those offsets lie.
    PIPELINE="${PIPELINE//,argpromotion/}"
    PIPELINE="${PIPELINE//,globalopt/}"
    # GOC_OPT_EXTRA: extra opt flags for experiments (default empty). The
    # textual pipeline above does not carry default<O3>'s inliner threshold
    # (250; a textual "inline" uses 225), see docs/perf-gap.md.
    local -a OPT_EXTRA=()
    read -r -a OPT_EXTRA <<<"${GOC_OPT_EXTRA:-}"
    if ! "$OPT" "-passes=$PIPELINE" "${OPT_EXTRA[@]}" -S "$BODY_LL" -o "$TMP/a.opt.ll"; then
      cleanup_build_tmp
      exit 1
    fi
    BODY_LL="$TMP/a.opt.ll"
    echo "goc build: O$OPT_LEVEL inlined before stack maps" >&2
    # Inlining is done. Record maps on the surviving functions, then spill
    # frame addresses O3 left in SSA across calls. Nothing after this may
    # inline: a caller cannot retarget a callee's frame-word offsets.
    # goc-pin-i64 is not run. Spill slots share; root allocas do not. The
    # hoisted g value lives in a callee-saved register, not a colored spill.
    # Integer fragments stay in registers; the copier copies those spills
    # verbatim.
    if [[ $ALL -eq 1 && "${GOC_SPTR_MAPS:-0}" == 1 ]]; then
      local SMPASS="${GOC_STACKMAP:-$ROOT/backend/build/pass-out/GocStackMap.so}"
      [[ -f "$SMPASS" ]] || { echo "goc build: missing $SMPASS" >&2; cleanup_build_tmp; exit 1; }
      if ! "$OPT" -load-pass-plugin="$SMPASS" -passes=goc-stackmap \
          -S "$BODY_LL" -o "$TMP/a.sm.ll"; then
        cleanup_build_tmp
        exit 1
      fi
      BODY_LL="$TMP/a.sm.ll"
      STACKMAP_PREPARED=1
      if ! "$OPT" -load-pass-plugin="$SMPASS" -passes=goc-reanchor \
          -S "$BODY_LL" -o "$TMP/a.reanchor.ll"; then
        cleanup_build_tmp
        exit 1
      fi
      BODY_LL="$TMP/a.reanchor.ll"
    fi
  fi

  local FN
  FN="$(rg -o 'define [^@]*@([A-Za-z_][A-Za-z0-9_]*)' -r '$1' "$BODY_LL" | head -1 || true)"
  if [[ -z "$FN" ]]; then
    FN="$(rg -o 'define [^@]*@([A-Za-z_][A-Za-z0-9_]*)' -r '$1' "$TMP/a.ll" | head -1 || true)"
  fi
  if [[ $ALL -eq 1 ]]; then
    [[ -x "$REALBODY" ]] || { echo "goc build: missing real-body goobj builder" >&2; cleanup_build_tmp; exit 1; }
    local RB_ARGS=("$BODY_LL" "$OUT_O" --all)
    # 4th positional is the go_sym prefix; 3rd is the (unused) fn name.
    if [[ -n "${GOC_PKG:-}" ]]; then RB_ARGS+=("_" "$GOC_PKG"); fi
    if [[ $GOABI -eq 1 ]]; then RB_ARGS+=(--goabi); fi
    if [[ $ABI0 -eq 1 ]]; then RB_ARGS+=(--abi0); fi
    if GOC_ROOT="$ROOT" GOC_CLANG="$CLANG" GOC_OPT_LEVEL="$OPT_LEVEL" \
        GOC_ARCH="$GOC_ARCH" LLC="$LLC" \
        GOC_STACKMAP_PREPARED="$STACKMAP_PREPARED" \
        "$REALBODY" "${RB_ARGS[@]}"; then
      echo "goc build: wrote multi-function real-body goobj $OUT_O (all fns; not seedMIR)"
      cleanup_build_tmp
      return 0
    fi
    echo "goc build: multi-function real-body lower failed; no object emitted" >&2
    cleanup_build_tmp
    exit 1
  fi
  if [[ -n "$FN" ]]; then
    [[ -x "$REALBODY" ]] || { echo "goc build: missing real-body goobj builder" >&2; cleanup_build_tmp; exit 1; }
    local GOSYM="main.${FN}"
    case "$FN" in
      p28_real_body) GOSYM="main.P28RealBody" ;;
      p21_sptr_across_call) GOSYM="main.P21SptrAcrossCall" ;;
      p21_gptr_store) GOSYM="main.P21GptrStoreWB" ;;
    esac
    if GOC_ROOT="$ROOT" GOC_CLANG="$CLANG" GOC_OPT_LEVEL="$OPT_LEVEL" \
        GOC_ARCH="$GOC_ARCH" LLC="$LLC" \
        GOC_STACKMAP_PREPARED="$STACKMAP_PREPARED" \
        "$REALBODY" "$BODY_LL" "$OUT_O" "$FN" "$GOSYM"; then
      echo "goc build: wrote real-body goobj $OUT_O (fn=$FN; not seedMIR)"
      cleanup_build_tmp
      return 0
    fi
    echo "goc build: real-body lower failed for $FN; no object emitted" >&2
    cleanup_build_tmp
    exit 1
  fi

  echo "goc build: no defined function in $SRC; refusing a non-goobj LLVM object" >&2
  cleanup_build_tmp
  exit 1
}

cmd_test() {
  local ONLY_P27=0 ONLY_P28=0
  GOC_FLAG_MODE=driver
  while [[ $# -gt 0 ]]; do
    if goc_consume_flag "$1" "${2:-}"; then
      shift "$GOC_FLAG_SHIFT"
      continue
    fi
    case "$1" in
      --p27) ONLY_P27=1; shift ;;
      --p28) ONLY_P28=1; shift ;;
      --p21|--p22|--p23|--p24|--p25|--p26)
        echo "goc test: $1 is not a product test" >&2
        shift
        ;;
      *) echo "unknown goc test flag: $1" >&2; exit 2 ;;
    esac
  done
  unset GOC_FLAG_MODE
  # test-p28.sh calls realbody, which runs goc-llc. That binary needs the
  # clang tree's libLLVM, the same way goc build does.
  prepend_clang_lib "$(resolve_clang)"
  if [[ $ONLY_P27 -eq 1 ]]; then
    exec bash "$ROOT/scripts/test-p27.sh"
  fi
  if [[ $ONLY_P28 -eq 1 ]]; then
    exec bash "$ROOT/scripts/test-p28.sh"
  fi
  # Default: run P28 if clang available, else P27 plugin path
  if bash "$ROOT/scripts/test-p28.sh"; then
    echo "goc test: P28 ALL PASS"
    return 0
  fi
  echo "goc test: P28 unavailable/failed — trying P27 plugin goldens" >&2
  exec bash "$ROOT/scripts/test-p27.sh"
}

main() {
  if [[ $# -lt 1 ]]; then
    usage
    exit 2
  fi
  case "$1" in
    build) shift; cmd_build "$@" ;;
    go) shift; exec bash "$ROOT/scripts/goc-go.sh" "$@" ;;
    check) shift; exec bash "$ROOT/scripts/goc-check.sh" "$@" ;;
    toolchain) shift; exec bash "$ROOT/scripts/goc-toolchain.sh" "$@" ;;
    cc) shift; cmd_cc "$@" ;;
    test|pipeline) shift; cmd_test "$@" ;;
    version) cmd_version ;;
    help|-h|--help) usage ;;
    *)
      echo "unknown command: $1" >&2
      usage
      exit 2
      ;;
  esac
}

main "$@"
