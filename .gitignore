# Build outputs
build/
**/build/
clang-build/
*.o
*.goobj
*.a
*.so
*.dylib
*.dll
*.syso
*.llc.o
*.log
*.tmp
*.swp
*~

# Local LLVM / deps (never vendor blobs)
_deps/
third_party/llvm-project*/
third_party/llvm-*-build/
third_party/cmake-*/
third_party/ninja
third_party/quickjs-ng/
third_party/quickjs-bellard/

# Go module vendor trees (not our pass/vendor lite headers)
/vendor/
**/go/pkg/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Written by `goc go` when a package has no assembly file.
goc_marker_amd64.s

# Driver-local binaries
/bin/

# Python bytecode
__pycache__/
*.pyc

# Raw measurements live on the local docs-data branch (git worktree add ../goc-data docs-data).
/docs/perf-gap/data/
/docs/benchmark/data/
!internal/convert/testdata/golden/**/*.goobj
!internal/lower/testdata/goabi/*.log
