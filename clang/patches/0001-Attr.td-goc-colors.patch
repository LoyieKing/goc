--- a/clang/include/clang/Basic/Attr.td
+++ b/clang/include/clang/Basic/Attr.td
@@ -948,6 +948,36 @@
 +// goc P27 — pointer-color attributes (in-tree form of p27-clang-frontend plugin)
+// Out-of-tree plugin registers the same GNU spellings via ParsedAttrInfo until
+// a full clang rebuild lands these. See p27-clang-frontend/patches/.
+//===----------------------------------------------------------------------===//
+
+def GocCPtr : InheritableAttr {
+  let Spellings = [GNU<"goc_cptr">, CXX11<"goc", "cptr">, C23<"goc", "cptr">];
+  let Subjects = SubjectList<[Var, Field, TypedefName, ParmVar]>;
+  let Documentation = [Undocumented];
+  let SimpleHandler = 1;
+}
+def GocSPtr : InheritableAttr {
+  let Spellings = [GNU<"goc_sptr">, CXX11<"goc", "sptr">, C23<"goc", "sptr">];
