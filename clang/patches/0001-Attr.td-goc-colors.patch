+  let Spellings = [GNU<"goc_uptr">, CXX11<"goc", "uptr">, C23<"goc", "uptr">];
+  let Subjects = SubjectList<[Var, Field, TypedefName, ParmVar]>;
+  let Documentation = [Undocumented];
+  let SimpleHandler = 1;
+}
+def GocAutoPtr : InheritableAttr {
+  let Spellings = [GNU<"goc_auto_ptr">, CXX11<"goc", "auto_ptr">, C23<"goc", "auto_ptr">];
+  let Subjects = SubjectList<[Var, Field, TypedefName, ParmVar]>;
+  let Documentation = [Undocumented];
+  let SimpleHandler = 1;
